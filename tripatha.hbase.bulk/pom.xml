<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.tripatha</groupId>
        <artifactId>tripatha</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tripatha.hbase.bulk</artifactId>
    <name>Tripatha HBase bulk import</name>
    <description>The bulk build's files on HBase (SCALE-STUDY.md O10): HFiles with visibility tags, written with HBase's
        own writer and bulk-loaded. A module of its own because it needs hbase-server; tripatha.hbase stays on
        hbase-client and finds this one through ServiceLoader, so only the loader depends on it.</description>

    <dependencies>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.hbase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.hbase</groupId>
            <artifactId>hbase-server</artifactId>
            <exclusions>
                <!-- Only HBase's own modules: Hadoop comes from hadoop-client-api/runtime, as everywhere else, and
                     the region server's web pages (Jetty, Tomcat's JSP engine, servlets) aren't needed to write
                     and load files. -->
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hbase</groupId>
                    <artifactId>hbase-http</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.tomcat</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.servlet</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.servlet.jsp</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-runtime</artifactId>
        </dependency>
    </dependencies>
</project>
