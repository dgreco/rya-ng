<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.tripatha</groupId>
        <artifactId>tripatha</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <!-- Only built with -Pcoverage: merges every module's unit and integration test coverage into one report. -->
    <artifactId>tripatha.coverage</artifactId>
    <packaging>pom</packaging>
    <name>Tripatha Coverage Report</name>
    <description>Aggregated JaCoCo report of the unit and integration tests of every module.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.accumulo</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.accumulo.iterators</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.hbase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.hbase.coprocessor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.hbase.bulk</artifactId>
        </dependency>
        <dependency>
            <!-- its own tests are the store-level integration tests, which cover tripatha.store -->
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.sail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.sparql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.loader</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.tripatha</groupId>
            <artifactId>tripatha.spark</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>tripatha</title>
                            <!-- every *.exec in each module's target: jacoco.exec (unit) and jacoco-it.exec (integration) -->
                            <dataFileIncludes>
                                <dataFileInclude>target/*.exec</dataFileInclude>
                            </dataFileIncludes>
                            <!-- protoc's output (tripatha.hbase.coprocessor/generate-protos.sh), not ours to test -->
                            <excludes>
                                <exclude>org/tripatha/hbase/coprocessor/protobuf/**</exclude>
                            </excludes>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                                <format>CSV</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
